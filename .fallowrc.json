{
  "$schema": "https://docs.fallow.tools/config-schema.json",
  "ignorePatterns": [
    ".next/**",
    ".fallow/**",
    "chrome-extension/dist/**",
    "convex/_generated/**",
    "myvibe-chatkit/**",
    "tmp/**"
  ],
  "duplicates": {
    "enabled": true,
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 0,
    "ignore": [
      "convex/_generated/**"
    ],
    "skipLocal": false,
    "crossLanguage": false,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "ignore": [
      "convex/_generated/**"
    ],
    "ownership": {
      "botPatterns": [
        "*[bot]*",
        "dependabot*",
        "renovate*",
        "github-actions*",
        "svc-*",
        "*-service-account*"
      ],
      "emailMode": "handle"
    },
    "suggestInlineSuppression": true
  },
  "audit": {
    "deadCodeBaseline": ".fallow-baselines/dead-code.json",
    "healthBaseline": ".fallow-baselines/health.json",
    "dupesBaseline": ".fallow-baselines/dupes.json"
  }
}
