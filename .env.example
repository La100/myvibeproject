# App URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_UI_VIBE=

# Analytics / ads
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER_DOMAIN=

# AI
OPENAI_API_KEY=
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
# AI 2 uses the self-hosted ChatKit proxy by default.
NEXT_PUBLIC_CHATKIT_SELF_HOSTED_URL=/api/chatkit/self-hosted
NEXT_PUBLIC_CHATKIT_SELF_HOSTED_DOMAIN_KEY=
# URL of the self-hosted ChatKit server that the Next.js proxy forwards to.
CHATKIT_SELF_HOSTED_SERVER_URL=http://127.0.0.1:8011/chatkit
# Shared secret between the Next.js proxy and the self-hosted ChatKit server.
CHATKIT_SELF_HOSTED_INTERNAL_SECRET=
# Organization visualizations use a second self-hosted ChatKit backend.
NEXT_PUBLIC_CHATKIT_VISUALIZATIONS_URL=/api/chatkit/visualizations
NEXT_PUBLIC_CHATKIT_VISUALIZATIONS_DOMAIN_KEY=
CHATKIT_VISUALIZATIONS_SERVER_URL=http://127.0.0.1:8011/visualizations/chatkit
CHATKIT_VISUALIZATIONS_INTERNAL_SECRET=
GEMINI_API_KEY=
AI_DEBUG_LOGS=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CORE_USER_USD_PRICE_ID=
STRIPE_CORE_USER_PLN_PRICE_ID=
STRIPE_AI_USER_USD_PRICE_ID=
STRIPE_AI_USER_PLN_PRICE_ID=
STRIPE_AI_SCALE_USER_USD_PRICE_ID=
STRIPE_AI_SCALE_USER_PLN_PRICE_ID=
# Legacy fallback names still read by some subscription guards.
STRIPE_AI_PRICE_ID=
STRIPE_AI_SCALE_PRICE_ID=
STRIPE_CONNECT_DEFAULT_COUNTRY=PL

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Storage / R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Extension / clipper
CLIPPER_ALLOWED_ORIGINS=

# Shopping scraper fallback through Cloudflare Browser Rendering
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Messaging
TELEGRAM_BOT_TOKEN=

# Convex runtime
# These are examples only. Variables used by files in convex/ must also be set
# in Convex with `npx convex env set ...`; Railway/.env.local are not enough.
CONVEX_SITE_URL=
