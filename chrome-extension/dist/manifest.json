{
  "manifest_version": 3,
  "name": "MyVibeProject Web Clipper",
  "version": "3.0.0",
  "description": "Web clipper for MyVibeProject shopping lists",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "commands"
  ],
  "host_permissions": [
    "https://myvibeproject.com/*",
    "https://www.myvibeproject.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-clipper": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open web clipper"
    }
  },
  "action": {
    "default_title": "MyVibeProject Web Clipper"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css",
        "storageKeys.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
